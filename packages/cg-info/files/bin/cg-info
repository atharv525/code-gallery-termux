#!/data/data/com.termux/files/usr/bin/bash
# cg-info - quick system and toolchain info
b(){ printf '\033[1;36m%-10s\033[0m %s\n' "$1" "$2"; }
gp(){ getprop "$1" 2>/dev/null; }
b Device "$(gp ro.product.manufacturer) $(gp ro.product.model)"
b Android "$(gp ro.build.version.release) (SDK $(gp ro.build.version.sdk))"
b Arch "$(uname -m)"
b Kernel "$(uname -r)"
b Uptime "$(uptime -p 2>/dev/null || uptime)"
b Memory "$(free -h 2>/dev/null | awk '/Mem:/{print $3" / "$2}')"
b Storage "$(df -h "$HOME" 2>/dev/null | awk 'NR==2{print $3" / "$2" used"}')"
b Packages "$(dpkg -l 2>/dev/null | grep -c '^ii')"
echo
v(){ command -v "$1" >/dev/null && b "$2" "$("$@" 2>&1 | head -1)"; }
v python --version; v node --version; v go version; v rustc --version; v java -version
v clang --version; v php --version; v ruby --version; v git --version
true
