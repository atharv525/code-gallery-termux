#!/data/data/com.termux/files/usr/bin/bash
# cg-bugbounty - set up a bug-bounty / recon toolkit on Termux
# Usage: cg-bugbounty [menu | all | <group>...]
# Groups: recon scan fuzz dns web passwords utils wordlists
set -u
PREFIXBIN="${PREFIX:-/data/data/com.termux/files/usr}/bin"

c(){ printf '\033[1;36m%s\033[0m\n' "$*"; }
ok(){ printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[!]\033[0m %s\n' "$*"; }

# -- official Termux packages per group (installed with apt) --
apt_recon="nmap"
apt_scan="nmap rustscan"
apt_fuzz="dirb feroxbuster"
apt_dns="dnsutils"
apt_web="nikto whatweb"          # tried; skipped automatically if not in your repos
apt_passwords="hydra john hashcat"
apt_utils="proxychains-ng netcat-openbsd socat tcpdump jq"

# -- Go tools:  "binary=go-install-path" --
go_recon="subfinder=github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
assetfinder=github.com/tomnomnom/assetfinder@latest
amass=github.com/owasp-amass/amass/v4/...@master"
go_scan="naabu=github.com/projectdiscovery/naabu/v2/cmd/naabu@latest
httpx=github.com/projectdiscovery/httpx/cmd/httpx@latest
nuclei=github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
go_fuzz="ffuf=github.com/ffuf/ffuf/v2@latest
gobuster=github.com/OJ/gobuster/v3@latest"
go_dns="dnsx=github.com/projectdiscovery/dnsx/cmd/dnsx@latest
puredns=github.com/d3mondev/puredns/v2@latest"
go_web="katana=github.com/projectdiscovery/katana/cmd/katana@latest
dalfox=github.com/hahwul/dalfox/v2@latest
gau=github.com/lc/gau/v2/cmd/gau@latest
waybackurls=github.com/tomnomnom/waybackurls@latest
hakrawler=github.com/hakluke/hakrawler@latest"
go_utils="httprobe=github.com/tomnomnom/httprobe@latest
anew=github.com/tomnomnom/anew@latest
gf=github.com/tomnomnom/gf@latest
unfurl=github.com/tomnomnom/unfurl@latest
qsreplace=github.com/tomnomnom/qsreplace@latest
notify=github.com/projectdiscovery/notify/cmd/notify@latest
interactsh-client=github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest"

# -- Python (pip) tools --
pip_web="sqlmap wafw00f arjun"
pip_dns="dnsrecon"
pip_recon="theHarvester"

GROUPS="recon scan fuzz dns web passwords utils wordlists"

have(){ command -v "$1" >/dev/null 2>&1; }

ensure_go(){
  have go && return 0
  warn "Go not installed - needed for most recon tools."
  read -rp "Install golang now? [Y/n] " a; case "$a" in n*|N*) return 1;; esac
  apt install -y golang || return 1
}
ensure_pip(){
  have pip && return 0
  apt install -y python python-pip
}
goenv(){
  export GOBIN="$PREFIXBIN"
  export GOFLAGS="-buildvcs=false"
  export GOPROXY="${GOPROXY:-https://proxy.golang.org,direct}"
}

apt_group(){
  local names="$1" want=() p
  for p in $names; do want+=("$p"); done
  [ ${#want[@]} -eq 0 ] && return 0
  apt update -y >/dev/null 2>&1
  for p in "${want[@]}"; do
    if apt-cache show "$p" >/dev/null 2>&1; then
      apt install -y "$p" && ok "$p" || warn "apt failed: $p"
    else warn "skip $p (not in your repos)"; fi
  done
}
go_group(){
  local list="$1" line bin path
  [ -z "$list" ] && return 0
  ensure_go || { warn "skipping Go tools"; return 0; }
  goenv
  printf '%s\n' "$list" | while IFS='=' read -r bin path; do
    [ -z "$bin" ] && continue
    if have "$bin"; then ok "$bin (already)"; continue; fi
    c "go install $bin ..."
    if go install "$path" 2>/tmp/cg-bb.log; then ok "$bin"
    else warn "go install failed: $bin (see /tmp/cg-bb.log)"; fi
  done
}
pip_group(){
  local names="$1" p
  [ -z "$names" ] && return 0
  ensure_pip
  for p in $names; do
    c "pip install $p ..."
    pip install --upgrade "$p" >/dev/null 2>&1 && ok "$p" || warn "pip failed: $p"
  done
}
wordlists(){
  local dir="$HOME/wordlists"
  mkdir -p "$dir"
  if [ ! -d "$dir/SecLists/.git" ]; then
    c "Cloning SecLists (shallow, ~1 GB) into $dir/SecLists ..."
    git clone --depth 1 https://github.com/danielmiessler/SecLists.git "$dir/SecLists" \
      && ok "SecLists at $dir/SecLists" || warn "clone failed"
  else ok "SecLists already at $dir/SecLists"; fi
  if [ ! -f "$dir/common.txt" ]; then
    curl -fsSL -o "$dir/common.txt" \
      https://raw.githubusercontent.com/v0re/dirb/master/wordlists/common.txt 2>/dev/null \
      && ok "common.txt" || true
  fi
}

do_group(){
  case "$1" in
    recon)     apt_group "$apt_recon"; go_group "$go_recon"; pip_group "$pip_recon" ;;
    scan)      apt_group "$apt_scan"; go_group "$go_scan" ;;
    fuzz)      apt_group "$apt_fuzz"; go_group "$go_fuzz" ;;
    dns)       apt_group "$apt_dns"; go_group "$go_dns"; pip_group "$pip_dns" ;;
    web)       apt_group "$apt_web"; go_group "$go_web"; pip_group "$pip_web" ;;
    passwords) apt_group "$apt_passwords" ;;
    utils)     apt_group "$apt_utils"; go_group "$go_utils" ;;
    wordlists) wordlists ;;
    *) warn "unknown group: $1"; return 1 ;;
  esac
}

usage(){
  c "cg-bugbounty - bug-bounty toolkit installer"
  echo "Usage: cg-bugbounty [all | <group>...]"
  echo "Groups:"
  echo "  recon      subfinder assetfinder amass theHarvester nmap"
  echo "  scan       naabu httpx nuclei rustscan"
  echo "  fuzz       ffuf gobuster dirb feroxbuster"
  echo "  dns        dnsx puredns dnsrecon dnsutils"
  echo "  web        katana dalfox gau waybackurls hakrawler sqlmap wafw00f arjun nikto whatweb"
  echo "  passwords  hydra john hashcat"
  echo "  utils      httprobe anew gf unfurl qsreplace notify interactsh netcat socat tcpdump proxychains"
  echo "  wordlists  SecLists + common.txt into ~/wordlists"
  echo
  echo "Note: Go tools build from source (needs golang + a few GB + time)."
  echo "      Tools land in \$PREFIX/bin, so they run like any pkg (e.g. 'subfinder -d site.com')."
}

main(){
  case "${1:-}" in
    -h|--help|help) usage; return ;;
    all) set -- recon scan fuzz dns web passwords utils ;;
    "")
      usage; echo
      read -rp "Groups to install (e.g. 'all' or 'recon scan web'): " ans
      [ -z "$ans" ] && return
      [ "$ans" = all ] && ans="recon scan fuzz dns web passwords utils"
      set -- $ans ;;
  esac
  for g in "$@"; do do_group "$g"; done
  echo
  ok "Done. Installed tools are in \$PREFIX/bin. Run 'cg-info' to check versions."
  warn "Use these only on targets you are authorised to test."
}
main "$@"
