#!/data/data/com.termux/files/usr/bin/bash
# cg-serve - quick web server for a folder
dir=${1:-.}; port=${2:-8080}
[ -d "$dir" ] || { echo "Usage: cg-serve [folder] [port]"; exit 1; }
cd "$dir" || exit 1
ip=$(ifconfig 2>/dev/null | awk '/inet /{print $2}' | grep -v '^127\.' | head -1)
echo "Serving $(pwd)"
echo "  Local:   http://localhost:$port"
[ -n "$ip" ] && echo "  Network: http://$ip:$port"
echo "Press Ctrl+C to stop."
if [ -f index.php ] && command -v php >/dev/null; then exec php -S 0.0.0.0:"$port"
elif command -v python >/dev/null; then exec python -m http.server "$port" --bind 0.0.0.0
elif command -v php >/dev/null; then exec php -S 0.0.0.0:"$port"
else echo "Install python or php first: pkg install python"; exit 1; fi
